<%- include('partials/header') %>

    <section class="crud-page py-5" style="background-color: #f4f7f6; min-height: 80vh;">
        <div class="container">
            <div class="row mb-5 align-items-center">
                <div class="col-md-6">
                    <h2 style="color: #151d42; font-weight: bold;">Product Registry</h2>
                    <p class="text-muted">Manage your inventory efficiently.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <button class="btn btn-gold shadow-sm" data-bs-toggle="modal" data-bs-target="#productModal"
                        onclick="prepareAddProduct()">
                        + Add New Product
                    </button>
                </div>
            </div>

            <!-- Search & Filter (Visual Only for now) -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="search-container">
                        <i class="fas fa-search text-muted me-3"></i>
                        <input type="text" class="search-input" placeholder="Search products by name or category...">
                    </div>
                </div>
            </div>

            <div class="table-container fade-in-up">
                <div class="table-responsive">
                    <table class="table-premium w-100 align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Product Name</th>
                                <th scope="col">Description</th>
                                <th scope="col">Categories</th>
                                <th scope="col">Price</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="productTable">
                            <!-- Dynamic Content -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- Product Modal -->
    <div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header bg-gradient-primary text-white"
                    style="background: linear-gradient(135deg, #151d42 0%, #1e2a5e 100%); border: none; padding: 20px 30px;">
                    <h5 class="modal-title fw-bold" id="modalTitle">Add New Product</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 p-md-5" style="background: #ffffff;">
                    <form id="productForm">
                        <input type="hidden" id="productId">

                        <div class="mb-4">
                            <label for="productName" class="form-label text-muted small fw-bold text-uppercase">Product
                                Name</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0" id="productName"
                                required placeholder="e.g. Security Camera X1">
                        </div>

                        <div class="mb-4">
                            <label for="productDesc"
                                class="form-label text-muted small fw-bold text-uppercase">Description</label>
                            <textarea class="form-control form-control-lg bg-light border-0" id="productDesc" rows="3"
                                required placeholder="Brief description of the product..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="productCats"
                                class="form-label text-muted small fw-bold text-uppercase">Categories</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0" id="productCats"
                                required placeholder="e.g. Electronics, Security">
                            <div class="form-text">Separate multiple categories with commas</div>
                        </div>

                        <div class="mb-4">
                            <label for="productPrice" class="form-label text-muted small fw-bold text-uppercase">Price
                                (Rs.)</label>
                            <input type="number" class="form-control form-control-lg bg-light border-0"
                                id="productPrice" required placeholder="e.g. 5000">
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="orderImmediately"
                                onchange="toggleOrderEmail()">
                            <label class="form-check-label text-muted small fw-bold text-uppercase"
                                for="orderImmediately">
                                Order this product immediately?
                            </label>
                        </div>

                        <div id="orderEmailContainer" class="mb-4" style="display: none;">
                            <label for="orderEmail" class="form-label text-muted small fw-bold text-uppercase">Your
                                Email Address</label>
                            <input type="email" class="form-control form-control-lg bg-light border-0" id="orderEmail"
                                placeholder="your@email.com">
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-gold btn-lg shadow-sm fw-bold">Save Product</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS (Required for Modal) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleOrderEmail() {
            const isChecked = document.getElementById('orderImmediately').checked;
            document.getElementById('orderEmailContainer').style.display = isChecked ? 'block' : 'none';
            document.getElementById('orderEmail').required = isChecked;
        }
    </script>

    <%- include('partials/footer') %>