<%- include('partials/header') %>

    <section class="crud-page py-5" style="background-color: #f4f7f6; min-height: 80vh;">
        <div class="container">
            <div class="row mb-5 align-items-center">
                <div class="col-md-6">
                    <h2 style="color: #151d42; font-weight: bold;">Product Registry</h2>
                    <p class="text-muted">Manage your inventory efficiently.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <button class="btn btn-gold shadow-sm" onclick="addProduct()">
                        + Add New Product
                    </button>
                </div>
            </div>

            <!-- Search & Filter (Visual Only for now) -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <input type="text" class="form-control w-100" placeholder="Search products by name or category..."
                        style="background: white; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                </div>
            </div>

            <div class="table-container fade-in-up">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead style="background: #151d42; color: white; border-radius: 10px;">
                            <tr>
                                <th scope="col" style="border-top-left-radius: 10px;">Product Name</th>
                                <th scope="col">Description</th>
                                <th scope="col">Categories</th>
                                <th scope="col" style="border-top-right-radius: 10px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="productTable">
                            <!-- Dynamic Content -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <style>
        .fade-in-up {
            animation: fadeInUp 0.5s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <%- include('partials/footer') %>